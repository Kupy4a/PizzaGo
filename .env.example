# Supabase (optional). Without these, orders are saved to .data/orders.json
# and sign-in, "My orders" and the admin panel are disabled.
# Copy both lines from the "Connect" dialog of your Supabase project.
# Older projects use NEXT_PUBLIC_SUPABASE_ANON_KEY instead; either name works.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only key, required for storing orders when Supabase is enabled.
# Project Settings -> API Keys -> service_role (or Secret key). Never commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
